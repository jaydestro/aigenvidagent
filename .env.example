# Set only the variables for your chosen provider in the process environment.
# This file is a reference, not automatically loaded by aigenvidagent.
# Never put credential values in a brief or commit a filled environment file.

# Azure requests require your explicit subscription ID, not a cached default.
AIGENVIDAGENT_AZURE_SUBSCRIPTION_ID=
# speech.auth=key: resource key. No Entra RBAC is used.
SPK=
# speech.auth=entra: Cognitive Services token; requires Speech User RBAC on
# the Speech resource and a resource configured for Entra authentication.
AZURE_ACCESS_TOKEN=
# speech.auth=speech_token: legacy regional Speech STS token, NOT Entra.
# Legacy default key mode also accepts this when SPK is absent.
SPEECH_TOKEN=

# OpenAI project key with audio/speech access; no Azure RBAC.
# Supply model and voices in speech config; no live voice-discovery API exists.
OPENAI_API_KEY=
# ElevenLabs key with voices/models read and text-to-speech access.
ELEVENLABS_API_KEY=

# Cloud previews send the excerpt and delivery/pronunciation choices to the
# selected service and can incur model/account charges. Trimming returned audio
# does not limit billed generation. Explain auth/data/cost before obtaining
# consents.speech_samples=true. With speech.providers, also require each
# selected cloud provider ID in consents.provider_samples (list or boolean map).
# speech.providers entries: id, provider, model, locale and nonsecret settings.
# Existing voices/preview commands accept provider-id/voice-id for these entries.
# Multiple entries may use the same service with different models.
# Call aigenvidagent.speech.providers(speech_config) for offline auth/data/cost metadata.
# Piper uses no credentials: provider=piper, model_path=<workspace model.onnx>,
# model_approved=true; retain the adjacent model.onnx.json and install piper on
# PATH separately with approval. Nothing is downloaded or installed by aigenvidagent.
